{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TodoHub",
  "version": "0.3.0",
  "identifier": "com.tdody.todohub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TodoHub",
        "width": 1120,
        "height": 800,
        "minWidth": 760,
        "minHeight": 520,
        "visible": false,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNBNDgwQjdFODRGQkNCNTMKUldSVHkvdUVmZ3RJT29HVjBLelVMVFh0SDNtZXQrbEdJaWI4ZFJGQWp1NmhURDNMOVl2RytPTkkK",
      "endpoints": ["https://github.com/tdody/todo-hub/releases/latest/download/latest.json"]
    }
  }
}
